#!/bin/sh
# cross-review-gate dispatcher template. bootstrap.ps1 exports this file's
# trusted HEAD object into .git/hooks/pre-commit. The installed copy is
# per-clone state outside the working tree, so a commit cannot edit or remove
# the active dispatcher through the review flow. The dispatcher rejects a
# missing or untrusted in-tree gate unless the audited bootstrap/repair bypass
# is explicitly selected.

ensure_unix_tool_path() {
  # Git for Windows hooks launched from PowerShell can inherit /cmd without
  # /usr/bin. The dispatcher depends on POSIX tools from /usr/bin (mktemp,
  # rm, chmod, mkdir, date), so repair PATH before any such call.
  for d in /usr/bin /bin; do
    if [ -d "$d" ]; then
      case ":$PATH:" in
        *":$d:"*) ;;
        *) PATH="$d:$PATH" ;;
      esac
    fi
  done
  export PATH
}
ensure_unix_tool_path

REPO_ROOT="$(git rev-parse --show-toplevel)"
GATE_HOOK="$REPO_ROOT/scripts/git-hooks/pre-commit"
SKIP_LOG_DIR="$REPO_ROOT/logs/review-skips"
SKIP_LOG="$SKIP_LOG_DIR/review-skip-log.txt"

# Write a skip-audit entry. Mirrors the in-tree gate's skip-log
# discipline so the dispatcher-level bypass is recorded too. Fails
# closed if the log cannot be written: a bypass without an audit
# trail defeats the CROSS_REVIEW_SKIP=1 contract.
write_skip_log() {
  if ! mkdir -p "$SKIP_LOG_DIR" 2>/dev/null; then
    echo "[pre-commit:dispatcher] ERROR: could not create $SKIP_LOG_DIR for skip audit log" >&2
    echo "[pre-commit:dispatcher] Bypass cannot proceed without audit trail. Aborting commit." >&2
    return 1
  fi
  AUDIT_TIMESTAMP=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || return 1
  printf '%s\n' "$AUDIT_TIMESTAMP" |
    grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' ||
    return 1
  if ! AUDIT_BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null); then
    AUDIT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 1
  fi
  [ -n "$AUDIT_BRANCH" ] || return 1
  AUDIT_STAGED_TREE=$(git write-tree 2>/dev/null) || return 1
  case "$AUDIT_STAGED_TREE" in
    ''|*[!0-9a-f]*) return 1 ;;
  esac
  case "${#AUDIT_STAGED_TREE}" in
    40|64) ;;
    *) return 1 ;;
  esac
  AUDIT_RECORD="$AUDIT_TIMESTAMP event=review-skip backend=none branch=$AUDIT_BRANCH staged-tree=$AUDIT_STAGED_TREE"
  if ! printf '%s\n' "$AUDIT_RECORD" >> "$SKIP_LOG"; then
    echo "[pre-commit:dispatcher] ERROR: could not append to $SKIP_LOG" >&2
    echo "[pre-commit:dispatcher] Bypass cannot proceed without audit trail. Aborting commit." >&2
    return 1
  fi
  return 0
}

if [ ! -f "$GATE_HOOK" ]; then
  if [ "$CROSS_REVIEW_SKIP" = "1" ]; then
    # User explicitly bypassed via CROSS_REVIEW_SKIP=1; let it through
    # ONLY after recording the bypass in the skip audit log. The
    # in-tree gate would have written this entry itself when present;
    # the dispatcher writes it here when the gate is missing so the
    # audit trail still records every bypass.
    if ! write_skip_log; then
      exit 1
    fi
    echo "[pre-commit:dispatcher] CROSS_REVIEW_SKIP=1 with in-tree gate missing -- bypass logged to $SKIP_LOG"
    exit 0
  fi
  echo "[pre-commit:dispatcher] ERROR: in-tree gate not found at $GATE_HOOK" >&2
  echo "[pre-commit:dispatcher] A commit removed or never installed the cross-review gate." >&2
  echo "[pre-commit:dispatcher] If intentional, re-install via bootstrap.ps1 or set" >&2
  echo "[pre-commit:dispatcher] CROSS_REVIEW_SKIP=1 for THIS one commit (audited bypass):" >&2
  echo "[pre-commit:dispatcher]   PowerShell:  \$env:CROSS_REVIEW_SKIP = '1'; git commit ...; Remove-Item Env:CROSS_REVIEW_SKIP" >&2
  echo "[pre-commit:dispatcher]   bash:        CROSS_REVIEW_SKIP=1 git commit ..." >&2
  exit 1
fi

# In-tree gate exists in the working tree. Verify it is also tracked
# in HEAD: an untracked working-tree gate has no trusted baseline.
# CROSS_REVIEW_SKIP=1 bypasses this for the initial bootstrap commit
# (when HEAD has no gate yet).
HEAD_HAS_GATE=0
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  if git cat-file -e HEAD:scripts/git-hooks/pre-commit 2>/dev/null; then
    HEAD_HAS_GATE=1
  fi
fi
if [ "$HEAD_HAS_GATE" -ne 1 ]; then
  if [ "$CROSS_REVIEW_SKIP" = "1" ]; then
    # Bootstrap-commit path. The in-tree gate is in the working tree
    # but not yet in HEAD; CROSS_REVIEW_SKIP=1 lets it land so the gate
    # files reach HEAD. Log the bypass for audit.
    if ! write_skip_log; then
      exit 1
    fi
    echo "[pre-commit:dispatcher] CROSS_REVIEW_SKIP=1 with gate not in HEAD -- bootstrap bypass logged to $SKIP_LOG"
    exit 0
  fi
  echo "[pre-commit:dispatcher] ERROR: in-tree gate at $GATE_HOOK is not tracked in HEAD." >&2
  echo "[pre-commit:dispatcher] For the initial bootstrap commit, stage the gate files and use:" >&2
  echo "[pre-commit:dispatcher]   PowerShell:  \$env:CROSS_REVIEW_SKIP = '1'; git commit ...; Remove-Item Env:CROSS_REVIEW_SKIP" >&2
  echo "[pre-commit:dispatcher]   bash:        CROSS_REVIEW_SKIP=1 git commit ..." >&2
  exit 1
fi

# CRITICAL: exec HEAD's gate, NOT the working-tree gate. Without this,
# a staged commit that REPLACES the in-tree hook with a no-op shell
# script would silently approve itself: the dispatcher would verify
# `HEAD:scripts/git-hooks/pre-commit` exists (it does -- the previous
# commit's version), then exec the WORKING-TREE no-op, which exits 0
# and lets the gate-disabling commit land with no actual review. The
# bypass would mirror the very `git rm gate` hole the dispatcher
# exists to close.
#
# Extract HEAD's gate to a per-invocation temp file and exec THAT. The
# working-tree gate is purely reviewed data, never executed directly.
# The HEAD-trusted gate then runs its own per-backend trusted-copy
# bootstrap against any staged changes to the wrappers/prompt
# templates, so the entire trust chain (dispatcher -> hook -> wrapper)
# always executes a HEAD-derived trusted copy.
TRUSTED_HOOK=$(mktemp 2>/dev/null || mktemp -t crg-pre-commit-dispatch)
if [ -z "$TRUSTED_HOOK" ] || [ ! -f "$TRUSTED_HOOK" ]; then
  echo "[pre-commit:dispatcher] ERROR: could not create tempfile for trusted hook copy" >&2
  exit 1
fi
trap 'rm -f "$TRUSTED_HOOK"' EXIT
if ! git show HEAD:scripts/git-hooks/pre-commit > "$TRUSTED_HOOK" 2>/dev/null; then
  echo "[pre-commit:dispatcher] ERROR: git show HEAD:scripts/git-hooks/pre-commit failed" >&2
  exit 1
fi
chmod +x "$TRUSTED_HOOK" 2>/dev/null
"$TRUSTED_HOOK" "$@"
status=$?
rm -f "$TRUSTED_HOOK"
trap - EXIT
exit "$status"
