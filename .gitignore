# Python caches and local environments
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Native build outputs
CMakeFiles/
cmake-build-*/
build/
build-windows-*/
dist/

# AR4 runtime and machine-specific state
/ARconfig.json
/custom.json
/ErrorLog
/ARbot.cal
/ARbot.cal.bak
# Preserve backups created by pre-rename builds on case-sensitive filesystems.
/Arbot.cal.bak
/.ARconfig.json.*.tmp
/.custom.json.*.tmp
/curImage.jpg
/temp.jpg
/gcode-storage-state.json
/gcode-storage-state.json.lock
/.gcode-storage-state-*.tmp

# Editor and operating-system state
.idea/
.vscode/
.DS_Store
Thumbs.db

# cross-review-gate generated artifacts (verdict logs, dispatch-checklist, skip and reviewer-fallback logs)
logs/
